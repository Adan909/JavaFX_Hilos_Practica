<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="18.0" prefWidth="560.0" prefHeight="420.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.practicahilos.ProcesadorController"
      style="-fx-background-color: #f8f9fa;">

    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
    </padding>

    <!-- Título Principal -->
    <Label text="Procesador de registros"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <Label text="Caso de estudio: NicaData Solutions S.A."
           style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>

    <!-- Etiqueta de Estado Dinámico -->
    <Label fx:id="lblEstado" text="Esperando inicio"
           style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #34495e;"/>

    <!-- Barra de Progreso Principal -->
    <ProgressBar fx:id="barraProgreso" prefWidth="440.0" prefHeight="26.0" progress="0.0"
                 style="-fx-accent: #27ae60;"/>

    <!-- Etiqueta de Porcentaje -->
    <Label fx:id="lblPorcentaje" text="0%"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2980b9;"/>

    <!-- Panel de Botones de Control de la Práctica Base -->
    <HBox alignment="CENTER" spacing="15.0">
        <Button fx:id="btnIniciar" text="Iniciar" onAction="#iniciarProceso"
                prefWidth="110.0" prefHeight="35.0"
                style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"/>

        <Button fx:id="btnDetener" text="Detener" onAction="#detenerProceso" disable="true"
                prefWidth="110.0" prefHeight="35.0"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"/>

        <Button fx:id="btnReiniciar" text="Reiniciar" onAction="#reiniciarProceso"
                prefWidth="110.0" prefHeight="35.0"
                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"/>
    </HBox>

    <Separator prefWidth="480.0"/>

    <!-- Acciones Complementarias: Reto Final y Demostración de Anti-patrón -->
    <HBox alignment="CENTER" spacing="15.0">
        <Button fx:id="btnRetoFinal" text="🚀 Abrir Reto Final (Monitor)" onAction="#abrirRetoFinal"
                prefWidth="220.0" prefHeight="32.0"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"/>

        <Button fx:id="btnBloqueante" text="⚠️ Proceso Bloqueante (Anti-patrón)" onAction="#procesoBloqueante"
                prefWidth="240.0" prefHeight="32.0"
                style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"/>
    </HBox>

</VBox>
