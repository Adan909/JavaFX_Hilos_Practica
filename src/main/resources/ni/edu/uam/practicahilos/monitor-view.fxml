<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="16.0" prefWidth="640.0" prefHeight="540.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.practicahilos.MonitorController"
      style="-fx-background-color: #f8f9fa;">

    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0"/>
    </padding>

    <!-- Título Principal del Reto -->
    <Label text="Monitor de Procesamiento Empresarial"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
    <Label text="Ejecución simultánea e independiente con hilos en segundo plano"
           style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>

    <!-- ===================================================================== -->
    <!-- SECCIÓN 1: HILO DE CLIENTES (100 registros - 100 ms)                 -->
    <!-- ===================================================================== -->
    <VBox spacing="8.0" style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label text="👤 Proceso 1: Clientes" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label text="(100 registros | 100 ms/reg)" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
        </HBox>

        <Label fx:id="lblEstadoClientes" text="Esperando inicio"
               style="-fx-font-size: 13px; -fx-text-fill: #34495e; -fx-font-weight: 500;"/>

        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <ProgressBar fx:id="barraProgresoClientes" prefWidth="480.0" prefHeight="22.0" progress="0.0"
                         style="-fx-accent: #3498db;"/>
            <Label fx:id="lblPorcentajeClientes" text="0%"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2980b9; -fx-min-width: 45px;"/>
        </HBox>

        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Button fx:id="btnIniciarClientes" text="Iniciar Clientes" onAction="#iniciarClientes"
                    prefWidth="130.0" prefHeight="28.0"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4;"/>
            <Button fx:id="btnDetenerClientes" text="Detener" onAction="#detenerClientes" disable="true"
                    prefWidth="90.0" prefHeight="28.0"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4;"/>
            <Button fx:id="btnReiniciarClientes" text="Reiniciar" onAction="#reiniciarClientes"
                    prefWidth="90.0" prefHeight="28.0"
                    style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4;"/>
        </HBox>
    </VBox>

    <!-- ===================================================================== -->
    <!-- SECCIÓN 2: HILO DE PRODUCTOS (50 registros - 180 ms)                 -->
    <!-- ===================================================================== -->
    <VBox spacing="8.0" style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label text="📦 Proceso 2: Productos" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label text="(50 registros | 180 ms/reg)" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
        </HBox>

        <Label fx:id="lblEstadoProductos" text="Esperando inicio"
               style="-fx-font-size: 13px; -fx-text-fill: #34495e; -fx-font-weight: 500;"/>

        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <ProgressBar fx:id="barraProgresoProductos" prefWidth="480.0" prefHeight="22.0" progress="0.0"
                         style="-fx-accent: #9b59b6;"/>
            <Label fx:id="lblPorcentajeProductos" text="0%"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8e44ad; -fx-min-width: 45px;"/>
        </HBox>

        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Button fx:id="btnIniciarProductos" text="Iniciar Productos" onAction="#iniciarProductos"
                    prefWidth="130.0" prefHeight="28.0"
                    style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4;"/>
            <Button fx:id="btnDetenerProductos" text="Detener" onAction="#detenerProductos" disable="true"
                    prefWidth="90.0" prefHeight="28.0"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4;"/>
            <Button fx:id="btnReiniciarProductos" text="Reiniciar" onAction="#reiniciarProductos"
                    prefWidth="90.0" prefHeight="28.0"
                    style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4;"/>
        </HBox>
    </VBox>

    <Separator prefWidth="580.0"/>

    <!-- ===================================================================== -->
    <!-- CONTROLES GLOBALES                                                    -->
    <!-- ===================================================================== -->
    <HBox alignment="CENTER" spacing="15.0">
        <Button fx:id="btnIniciarTodos" text="⚡ Iniciar Ambos" onAction="#iniciarTodos"
                prefWidth="140.0" prefHeight="32.0"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"/>

        <Button fx:id="btnDetenerTodos" text="🛑 Detener Ambos" onAction="#detenerTodos"
                prefWidth="140.0" prefHeight="32.0"
                style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"/>

        <Button fx:id="btnReiniciarTodos" text="🔄 Reiniciar Ambos" onAction="#reiniciarTodos"
                prefWidth="140.0" prefHeight="32.0"
                style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"/>
    </HBox>

</VBox>
